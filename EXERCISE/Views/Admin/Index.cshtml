@model IEnumerable<EXERCISE_MVC.Models.Urun>

@{
    ViewData["Title"] = "Yönetim Paneli";
}

<div class="container mt-4">
    @* Başlık Bölümü *@
    <div class="row">
        <div class="col-12">
            <div class="alert alert-danger bg-dark text-white border-0 shadow py-4">
                <h1 class="display-5 mb-1 fw-bold">🛡️ GÜNES-MALL Yönetim Merkezi</h1>
                <p class="mb-0 text-light opacity-75">Hoş geldiniz Sayın Yönetici. Mağazanın tüm kontrolü şu an bu panelde.</p>
            </div>
        </div>
    </div>

    @* Hızlı İstatistik Kartları *@
    <div class="row mt-4">

        @* 1. TOPLAM ÜRÜN KARTI -> Ürün Listesine (Admin/Index) Gider *@
        <div class="col-md-4 mb-3">
            <a asp-controller="Admin" asp-action="Index" class="card bg-primary text-white shadow border-0 text-decoration-none btn text-start p-0 h-100" style="display: block;">
                <div class="card-body">
                    <h5 class="card-title opacity-75">Toplam Ürün</h5>
                    <h2 class="fw-bold mb-0">@(Model?.Count() ?? 0)</h2>
                </div>
            </a>
        </div>

        @* 2. GELEN SİPARİŞLER KARTI -> Sipariş Listesine (Admin/Siparisler) Gider *@
        <div class="col-md-4 mb-3">
            <a asp-controller="Admin" asp-action="Siparisler" class="card bg-success text-white shadow border-0 text-decoration-none btn text-start p-0 h-100" style="display: block;">
                <div class="card-body">
                    <h5 class="card-title opacity-75">Gelen Siparişler</h5>
                    <h2 class="fw-bold mb-0">@(ViewBag.ToplamSiparisSayisi ?? 0)</h2>
                </div>
            </a>
        </div>

        @* 3. KAYITLI MÜŞTERİ KARTI -> (Şimdilik boş kalmasın diye yine Index'e bağladım, ileride kullanıcı controller'ına bağlarsın) *@
        <div class="col-md-4 mb-3">
            <a asp-controller="Admin" asp-action="Index" class="card bg-warning text-dark shadow border-0 text-decoration-none btn text-start p-0 h-100" style="display: block;">
                <div class="card-body">
                    <h5 class="card-title opacity-75">Kayıtlı Müşteri</h5>
                    <h2 class="fw-bold mb-0">@(ViewBag.ToplamMusteriSayisi ?? 0)</h2>
                </div>
            </a>
        </div>

    </div>

    @* ÜRÜN YÖNETİM TABLOSU (YENİ EKLENDİ) *@
    <div class="row mt-4 mb-5">
        <div class="col-12">
            <div class="card shadow border-0">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom-0">
                    <h4 class="fw-bold mb-0 text-dark">Ürün Listesi</h4>
                    @* Yeni Ürün Ekleme Sayfasına Giden Buton *@
                    <a asp-controller="Admin" asp-action="Create" class="btn btn-success px-4 shadow-sm">
                        <i class="bi bi-plus-circle"></i> Yeni Ürün Ekle
                    </a>
                </div>
                <div class="table-responsive p-3">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 80px;">Görsel</th>
                                <th>Ürün Adı</th>
                                <th>Kategori</th>
                                <th class="text-end">Fiyat</th>
                                <th class="text-center">Stok</th>
                                <th class="text-center" style="width: 200px;">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var urun in Model)
                                {
                                    <tr>
                                        @* Ürün Görseli *@
                                        <td>
                                            @if (!string.IsNullOrEmpty(urun.ResimYolu))
                                            {
                                                <img src="~/img/@urun.ResimYolu" class="rounded border" style="width: 50px; height: 50px; object-fit: cover;" alt="@urun.Ad" />
                                            }
                                            else
                                            {
                                                <div class="rounded border bg-light d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                                    <i class="bi bi-image text-secondary"></i>
                                                </div>
                                            }
                                        </td>
                                        @* Ürün Adı *@
                                        <td><span class="fw-bold text-dark">@urun.Ad</span></td>
                                        @* Kategori *@
                                        <td><span class="badge bg-secondary">@urun.Kategori</span></td>
                                        @* Fiyat *@
                                        <td class="text-end fw-bold text-success">@urun.Fiyat.ToString("C2")</td>
                                        @* Stok Durumu (Kritik stoğa göre renk değiştirir) *@
                                        <td class="text-center">
                                            @if (urun.Stok == 0)
                                            {
                                                <span class="badge bg-danger">Tükendi</span>
                                            }
                                            else if (urun.Stok <= 5)
                                            {
                                                <span class="badge bg-warning text-dark">Kritik (@urun.Stok)</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info text-dark">@urun.Stok</span>
                                            }
                                        </td>
                                        @* Düzenle / Sil Butonları *@
                                        <td class="text-center">
                                            <div class="btn-group" role="group">
                                                <a asp-controller="Admin" asp-action="Edit" asp-route-id="@urun.Id" class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-pencil-square"></i> Düzenle
                                                </a>
                                                <a asp-controller="Admin" asp-action="Delete" asp-route-id="@urun.Id"
                                                   class="btn btn-sm btn-outline-danger" onclick="return confirm('@urun.Ad ürününü silmek istediğinize emin misiniz?')">
                                                    <i class="bi bi-trash"></i> Sil
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">
                                        <i class="bi bi-box-open display-6 d-block mb-2"></i>
                                        Veritabanında henüz hiç ürün bulunamadı.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>