<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] GÜNES-MALL</title>
    <!-- Bootstrap CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    @RenderSection("Style", required: false)
</head>

<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 shadow">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/Home/Index">GÜNES-MALL</a>

            <!-- Mobil görünüm için menü butonu -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link text-light fw-semibold" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door"></i> Ana Sayfa
                        </a>
                    </li>

                    <!-- KATEGORİLER BURAYA EKLENDİ -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-white" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Kategoriler
                        </a>
                        <ul class="dropdown-menu shadow" aria-labelledby="navbarDropdown">
                            <li><a class="dropdown-item" href="/Home/Index">Tüm Ürünler</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="/Home/Index?kategori=Elektronik">Elektronik</a></li>
                            <li><a class="dropdown-item" href="/Home/Index?kategori=Aksesuar">Aksesuar</a></li>
                        </ul>
                    </li>
                </ul>

                <!-- SAĞ TARAF: GİRİŞ, KAYIT, ÇIKIŞ YAP VE SEPET İKONU (DİNAMİK) -->
                <ul class="navbar-nav ms-auto align-items-center">
                    @* ms-auto: Tüm grubu sağa yaslar. align-items-center: Butonları dikeyde eşitler *@

                    @if (!User.Identity.IsAuthenticated)
                    {
                        <!-- Kullanıcı Giriş Yapmamışsa Gösterilecek Butonlar -->
                        <li class="nav-item me-2">
                            <a class="nav-link text-light px-3" href="/Account/Login">Giriş Yap</a>
                        </li>

                        <li class="nav-item me-3">
                            <a class="btn btn-sm btn-outline-light px-3" href="/Account/Register">Kayıt Ol</a>
                        </li>
                    }
                    else
                    {
                        <!-- Kullanıcı (Admin veya Customer) Giriş Yapmışsa Gösterilecek Çıkış Butonu -->
                        <li class="nav-item me-3">
                            <form action="/Account/Logout" method="post" class="d-inline m-0 p-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-link nav-link text-light px-3 py-0 border-0" style="background: none; font-size: inherit;">
                                    🚪 Çıkış Yap (@User.Identity.Name)
                                </button>
                            </form>
                        </li>
                    }

                    <!-- Sepet İkonu Her Zaman Sabit Kalır -->
                    <li class="nav-item">
                        <a class="nav-link btn btn-outline-info text-white px-3" href="/Home/Sepetim">
                            🛒 Sepetim
                            <span class="badge bg-danger ms-1">
                                @(Context.Session.GetString("Sepetim") != null
                                                                ? System.Text.Json.JsonSerializer.Deserialize<List<EXERCISE_MVC.Models.Urun>>(Context.Session.GetString("Sepetim")).Count
                                                                : 0)
                            </span>
                        </a>
                    </li>

                    @* AKILLI KİLİT: Sadece sisteme giriş yapmış ve rolü Admin olan kullanıcılar görebilir *@
                    @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="btn btn-danger btn-sm ms-lg-3 my-2 my-lg-0 text-white fw-bold shadow-sm"
                               asp-controller="Admin"
                               asp-action="Index">
                                <i class="bi bi-shield-lock-fill"></i> Yönetim Paneline Dön
                            </a>
                        </li>
                    }

                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5 py-3 text-center">
        <div class="container">
            &copy; 2026 - GÜNES-MALL - <a href="#">Gizlilik</a>
        </div>
    </footer>

    <!-- Bootstrap JS (Dropdown'ın çalışması için bu şart!) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>