@model List<EXERCISE_MVC.Models.SepetItem>

@* SweetAlert Linkini Temizledik *@
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<h2>Alışveriş Sepetim</h2>

<table class="table table-hover">
    <thead>
        <tr>
            <th>Ürün Görseli</th>
            <th>Ürün Adı</th>
            <th>Adet</th>
            <th>Fiyat</th>
            <th>Toplam</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @* Veritabanındaki ResimYolu kolonuna göre güncelledik *@
                        <img src="/img/@item.Urun.ResimYolu" width="50" alt="@item.Urun.Ad" />
                    </td>
                    <td>@item.Urun.Ad</td>
                    <td>
                        <a href="/Home/AdetAzalt/@item.Urun.Id" class="btn btn-sm btn-warning">-</a>
                        <span class="mx-2">@item.Adet</span>
                        <a href="/Home/AdetArtir/@item.Urun.Id" class="btn btn-sm btn-success">+</a>
                    </td>
                    <td>@item.Urun.Fiyat.ToString("C2")</td>
                    <td>@( (item.Urun.Fiyat * item.Adet).ToString("C2") )</td>
                    <td>
                        <a asp-controller="Home" asp-action="SepettenSil" asp-route-id="@item.Urun.Id" class="btn btn-danger">Sil</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">Sepetinizde henüz ürün bulunmuyor.</td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-4 border-top pt-3">
    @* Toplam Fiyat Bilgisi *@
    <div class="text-end mb-3">
        <h4>Genel Toplam: <span class="text-success">@(Model != null ? Model.Sum(x => x.Urun.Fiyat * x.Adet).ToString("C2") : "0,00 ₺")</span></h4>
    </div>

    @* Aksiyon Butonları *@
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <a href="/Home/Index" class="btn btn-outline-primary">
                <i class="fas fa-arrow-left"></i> Alışverişe Devam Et
            </a>
            <a href="/Home/SepetiTemizle" class="btn btn-outline-secondary ms-2">Sepeti Boşalt</a>
        </div>

        <div>
            @if (Model != null && Model.Any())
            {
                @* Tek ve net "Ödemeye Geç" butonu *@
                <a href="/Home/Odeme" class="btn btn-success btn-lg px-5">Ödemeye Geç</a>
            }
            else
            {
                <button type="button" onclick="sepetBosUyarisi()" class="btn btn-secondary btn-lg px-5">Ödemeye Geç</button>
            }
        </div>
    </div>
</div>


@* Script içindeki fazla parantezi temizledik *@
<script>
    function sepetBosUyarisi() {
        Swal.fire({
            title: 'Sepetiniz Boş!',
            text: 'Ödeme yapabilmek için sepetinize en az bir ürün eklemelisiniz.',
            icon: 'warning',
            confirmButtonText: 'Tamam',
            confirmButtonColor: '#3085d6'
        });
    }
</script>