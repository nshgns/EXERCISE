@model EXERCISE_MVC.Models.RegisterViewModel
@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card shadow border-0 rounded-3">
            <div class="card-header bg-dark text-white text-center py-3">
                <h4 class="mb-0 fw-bold">GÜNES-MALL</h4>
                <small class="text-light">Yeni Hesap Oluşturun</small>
            </div>
            <div class="card-body p-4">

                <form asp-action="Register" asp-controller="Account" method="post">
                    @Html.AntiForgeryToken()

                    <!-- Ad Soyad Alanı -->
                    <!-- AD ALANI -->
                    <div class="mb-3">
                        <label asp-for="Ad" class="form-label fw-semibold">Adınız</label>
                        <input asp-for="Ad" type="text" class="form-control" placeholder="Güneş" />
                        <span asp-validation-for="Ad" class="text-danger small"></span>
                    </div>

                    <!-- SOYAD ALANI -->
                    <div class="mb-3">
                        <label asp-for="Soyad" class="form-label fw-semibold">Soyadınız</label>
                        <input asp-for="Soyad" type="text" class="form-control" placeholder="Yılmaz" />
                        <span asp-validation-for="Soyad" class="text-danger small"></span>
                    </div>

                    <!-- E-Posta Alanı -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">E-Posta Adresi</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="ornek@gmail.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- Şifre Alanı -->
                    <div class="mb-3">
                        <label asp-for="Sifre" class="form-label fw-semibold">Şifre</label>
                        <input asp-for="Sifre" type="password" class="form-control" placeholder="En az 6 karakter" />
                        <span asp-validation-for="Sifre" class="text-danger small"></span>
                    </div>

                    <!-- Şifre Tekrar Alanı -->
                    <div class="mb-3">
                        <label asp-for="SifreTekrar" class="form-label fw-semibold">Şifre Tekrarı</label>
                        <input asp-for="SifreTekrar" type="password" class="form-control" placeholder="Şifrenizi tekrar girin" />
                        <span asp-validation-for="SifreTekrar" class="text-danger small"></span>
                    </div>

                    <!-- Kayıt Butonu -->
                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-dark btn-lg">Kayıt İşlemini Tamamla</button>
                    </div>
                </form>

            </div>
            <div class="card-footer bg-light text-center py-3">
                <p class="mb-0 text-muted small">Zaten üye misiniz? <a href="/Account/Login" class="text-dark fw-bold decoration-none">Giriş Yapın</a></p>
            </div>
        </div>
    </div>
</div>